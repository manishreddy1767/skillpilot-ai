{
  "name": "skillpilot-ai",
  "productName": "SkillPilot AI",
  "version": "0.0.1",
  "private": true,
  "description": "Private desktop career assistant that lives in a floating widget",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:desktop": "npm run build:test && powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop/widget.ps1",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build:test && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run test:desktop",
    "build:test": "electron-vite build --mode test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
